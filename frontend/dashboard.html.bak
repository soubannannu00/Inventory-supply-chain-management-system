<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard | Nexora Inventory</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="stylesheet" href="css/style.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <div class="app">
      <aside class="sidebar" id="sidebar" aria-label="Main navigation">
        <div class="brand">
          <span class="brand-mark" aria-hidden="true">
            <i class="fa-solid fa-boxes-stacked"></i>
          </span>
          <div>
            <p class="brand-name">Nexora</p>
            <p class="brand-sub">Inventory &amp; Supply Chain</p>
          </div>
        </div>

        <nav class="sidebar-nav">
          <p class="nav-label">Overview</p>
          <a class="nav-link is-active" href="dashboard.html" data-page="Dashboard">
            <i class="fa-solid fa-chart-pie" aria-hidden="true"></i>
            Dashboard
          </a>

          <p class="nav-label">Operations</p>
          <a class="nav-link" href="#" data-page="Products">
            <i class="fa-solid fa-box-open" aria-hidden="true"></i>
            Products
          </a>
          <a class="nav-link" href="#" data-page="Inventory">
            <i class="fa-solid fa-warehouse" aria-hidden="true"></i>
            Inventory
          </a>
          <a class="nav-link" href="#" data-page="Suppliers">
            <i class="fa-solid fa-truck-field" aria-hidden="true"></i>
            Suppliers
          </a>
          <a class="nav-link" href="#" data-page="Customers">
            <i class="fa-solid fa-users" aria-hidden="true"></i>
            Customers
          </a>
          <a class="nav-link" href="#" data-page="Purchases">
            <i class="fa-solid fa-cart-plus" aria-hidden="true"></i>
            Purchases
          </a>
          <a class="nav-link" href="#" data-page="Sales">
            <i class="fa-solid fa-receipt" aria-hidden="true"></i>
            Sales
          </a>
          <a class="nav-link" href="#" data-page="Warehouses">
            <i class="fa-solid fa-building" aria-hidden="true"></i>
            Warehouses
          </a>

          <p class="nav-label">Insights</p>
          <a class="nav-link" href="#" data-page="Reports">
            <i class="fa-solid fa-chart-column" aria-hidden="true"></i>
            Reports
          </a>
          <a class="nav-link" href="#" data-page="AI Assistant">
            <i class="fa-solid fa-robot" aria-hidden="true"></i>
            AI Assistant
          </a>
          <a class="nav-link" href="#" data-page="Settings">
            <i class="fa-solid fa-gear" aria-hidden="true"></i>
            Settings
          </a>
        </nav>

        <div class="sidebar-footer">
          <p>Nexora workspace</p>
          <p id="db-status" title="Checking database connection…"><span class="db-dot" aria-hidden="true"></span><span id="db-status-text">Live data · inventory_db</span></p>
        </div>
      </aside>

      <div class="overlay" id="overlay" hidden></div>

      <div class="shell">
        <header class="topbar">
          <div class="topbar-left">
            <button
              class="icon-btn menu-btn"
              id="menu-toggle"
              type="button"
              aria-label="Open navigation menu"
              aria-controls="sidebar"
              aria-expanded="false"
            >
              <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>
            <div>
              <h1>Dashboard</h1>
              <p class="topbar-meta">
                <time id="today-label" datetime=""></time>
                · <span id="warehouse-label">Pune Central Warehouse</span>
              </p>
            </div>
          </div>

          <div class="topbar-right">
            <label class="search">
              <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
              <input
                id="dashboard-search"
                type="search"
                placeholder="Search SKU, invoice, supplier…"
                autocomplete="off"
              />
            </label>
            <button class="icon-btn" type="button" aria-label="Notifications">
              <i class="fa-regular fa-bell" aria-hidden="true"></i>
              <span class="badge-dot" aria-hidden="true"></span>
            </button>
            <div class="user-chip">
              <span class="avatar">AD</span>
              <div>
                <p class="user-name">Admin</p>
                <p class="user-role">Inventory Manager</p>
              </div>
            </div>
          </div>
        </header>

        <main class="content" id="main">
          <div class="page-banner" id="page-banner" hidden role="status"></div>

          <section class="stats-grid" aria-label="Key statistics">
            <article class="stat-card">
              <div class="stat-icon teal">
                <i class="fa-solid fa-box-open" aria-hidden="true"></i>
              </div>
              <div>
                <p class="stat-label">Total Products</p>
                <p class="stat-value" id="stat-products">—</p>
                <p class="stat-hint">All SKUs in catalogue</p>
              </div>
            </article>
            <article class="stat-card">
              <div class="stat-icon navy">
                <i class="fa-solid fa-cubes" aria-hidden="true"></i>
              </div>
              <div>
                <p class="stat-label">Total Stock</p>
                <p class="stat-value" id="stat-stock">—</p>
                <p class="stat-hint">Units on hand · all warehouses</p>
              </div>
            </article>
            <article class="stat-card">
              <div class="stat-icon green">
                <i class="fa-solid fa-indian-rupee-sign" aria-hidden="true"></i>
              </div>
              <div>
                <p class="stat-label">Total Sales</p>
                <p class="stat-value" id="stat-sales">—</p>
                <p class="stat-hint">All time · sales orders</p>
              </div>
            </article>
            <article class="stat-card">
              <div class="stat-icon amber">
                <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
              </div>
              <div>
                <p class="stat-label">Total Purchases</p>
                <p class="stat-value" id="stat-purchases">—</p>
                <p class="stat-hint">All time · purchase orders</p>
              </div>
            </article>
            <article class="stat-card alert">
              <div class="stat-icon red">
                <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
              </div>
              <div>
                <p class="stat-label">Low Stock Items</p>
                <p class="stat-value" id="stat-low-stock">—</p>
                <p class="stat-hint">Below reorder level</p>
              </div>
            </article>
          </section>

          <section class="overview-grid">
            <article class="panel">
              <header class="panel-head">
                <div>
                  <h2>Sales Overview</h2>
                  <p>Last 7 days</p>
                </div>
                <span class="chip chip-success" id="sales-trend-chip">Last 7 days</span>
              </header>
              <div class="chart" id="sales-chart" role="img" aria-label="Daily sales for the last seven days"></div>
            </article>

            <article class="panel">
              <header class="panel-head">
                <div>
                  <h2>Purchase Overview</h2>
                  <p>Last 7 days · inbound spend</p>
                </div>
                <span class="chip" id="purchase-transit-chip">— orders in transit</span>
              </header>
              <div class="chart" id="purchase-chart" role="img" aria-label="Daily purchases for the last seven days"></div>
            </article>
          </section>

          <section class="tables-grid">
            <article class="panel">
              <header class="panel-head">
                <div>
                  <h2>Recent Sales</h2>
                  <p>Latest billed invoices</p>
                </div>
              </header>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th scope="col">Invoice</th>
                      <th scope="col">Customer</th>
                      <th scope="col">Amount</th>
                      <th scope="col">Status</th>
                    </tr>
                  </thead>
                  <tbody id="recent-sales"></tbody>
                </table>
              </div>
            </article>

            <article class="panel">
              <header class="panel-head">
                <div>
                  <h2>Low Stock Alerts</h2>
                  <p>Items that need reorder</p>
                </div>
              </header>
              <ul class="alert-list" id="low-stock-list"></ul>
            </article>

            <article class="panel panel-wide">
              <header class="panel-head">
                <div>
                  <h2>Recent Purchase Orders</h2>
                  <p>Supplier replenishment</p>
                </div>
              </header>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th scope="col">PO No.</th>
                      <th scope="col">Supplier</th>
                      <th scope="col">Warehouse</th>
                      <th scope="col">Amount</th>
                      <th scope="col">ETA</th>
                      <th scope="col">Status</th>
                    </tr>
                  </thead>
                  <tbody id="recent-purchases"></tbody>
                </table>
              </div>
            </article>
          </section>
        </main>
      </div>
    </div>
    <script src="js/dashboard.js"></script>
  </body>
</html>
